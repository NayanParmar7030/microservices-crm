# Docker Compose environment variables
# Generated from .env.docker.example
# Used by: docker compose --env-file .env.docker up --build
# Or rename this file to .env next to docker-compose.yml

POSTGRES_USER=crm
POSTGRES_PASSWORD=crm_dev_password
POSTGRES_PORT=5432
REDIS_PORT=6379
GATEWAY_PORT=3000

JWT_ACCESS_SECRET=change-me-access-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars!!
INTERNAL_SERVICE_SECRET=change-me-internal-service-secret

ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=604800

# Optional gateway tuning
GATEWAY_PROXY_TIMEOUT_MS=60000
