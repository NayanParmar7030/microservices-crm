# Copy to `.env` next to docker-compose.yml (Compose substitutes ${VAR} from that file by default),
# or run: docker compose --env-file .env.docker up --build
#
# Required: no insecure defaults in docker-compose for credentials.

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
REDIS_PORT=6379
GATEWAY_PORT=3000

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
INTERNAL_SERVICE_SECRET=

ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=604800

# Optional gateway tuning (not secrets)
GATEWAY_PROXY_TIMEOUT_MS=60000
