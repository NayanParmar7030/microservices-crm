# Copy to `.env` for local development or for Compose variable substitution.
# Docker Compose: copy `.env.docker.example` to `.env` (or pass `--env-file .env.docker`).
# Compose has no default database password; set strong values before `docker compose up`.

POSTGRES_USER=crm
POSTGRES_PASSWORD=crm_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars!!
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=604800

INTERNAL_SERVICE_SECRET=change-me-internal-service-secret

AUTH_SERVICE_PORT=3001
USER_SERVICE_PORT=3002
CRM_SERVICE_PORT=3003
GATEWAY_PORT=3000

USER_SERVICE_URL=http://localhost:3002
CRM_SERVICE_URL=http://localhost:3003
AUTH_SERVICE_URL=http://localhost:3001
